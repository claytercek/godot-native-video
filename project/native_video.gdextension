[configuration]
entry_symbol = "native_video_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]
macos.debug = "lib/libnative_video.dylib"
macos.release = "lib/libnative_video.dylib"
windows.debug = "lib/native_video.dll"
windows.release = "lib/native_video.dll"
linux.debug.x86_64 = "lib/libnative_video.so"
linux.release.x86_64 = "lib/libnative_video.so"
linux.debug.arm64 = "lib/libnative_video.so"
linux.release.arm64 = "lib/libnative_video.so"
